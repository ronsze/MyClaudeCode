{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/model-review.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__crashlytics__crashlytics_.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/skill-required.py\" diagnose"
          }
        ]
      }
    ]
  }
}
