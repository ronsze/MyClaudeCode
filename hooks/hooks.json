{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/model-review.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__crashlytics__crashlytics_.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/skill-required.py\" diagnose"
          }
        ]
      },
      {
        "matcher": "mcp__trello__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/skill-required.py\" trello"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/write-scope.py\" --agent test-engineer '(^|/)src/test/' '(^|/)tests?/' '(^|/)__tests__/' '[._]test[.][a-z]+$' 'Test[.][a-z]+$'"
          }
        ]
      }
    ]
  }
}
